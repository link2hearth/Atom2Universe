    <string name="hamlet_region_story_2">Vergers et ponts de pierre cachent de précieux savoir-faire.</string>
    <string name="hamlet_region_3">Anciennes tours</string>
    <string name="hamlet_region_story_3">Explore les collines et retrouve les plans d’anciens villages.</string>
    <string name="hamlet_region_4">Marais des lucioles</string>
    <string name="hamlet_region_story_4">Trouve des plantes rares au bord des cours d’eau lumineux.</string>
    <string name="hamlet_region_5">Hauts plateaux</string>
    <string name="hamlet_region_story_5">Le plus grand voyage rapporte de quoi financer les découvertes avancées.</string>
