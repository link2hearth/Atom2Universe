    <string name="hamlet_chapter_0">Les premiers voisins</string>
    <string name="hamlet_chapter_story_0">Un banc, quelques récoltes et un lieu où se retrouver : le village naît des petits gestes.</string>
    <string name="hamlet_chapter_1">Au-delà de la haie</string>
    <string name="hamlet_chapter_story_1">Ouvre un relais et accueille une petite équipe d’exploration.</string>
    <string name="hamlet_chapter_2">Un hameau qui grandit</string>
    <string name="hamlet_chapter_story_2">Les animaux, les semis et les nouveaux chemins donnent vie au hameau.</string>
    <string name="hamlet_chapter_3">Métiers et remèdes</string>
    <string name="hamlet_chapter_story_3">Améliore les ateliers et découvre les techniques rapportées par les voyageurs.</string>
    <string name="hamlet_chapter_4">Le temps des vergers</string>
    <string name="hamlet_chapter_story_4">Le village agricole développe ses propres métiers et remèdes.</string>
    <string name="hamlet_chapter_5">Un village sur la carte</string>
    <string name="hamlet_chapter_story_5">Tisse, échange et cartographie les vallées au-delà de tes champs.</string>
    <string name="hamlet_chapter_6">La foire de la vallée</string>
    <string name="hamlet_chapter_story_6">Un village prospère accueille des artisans et des voyages plus lointains.</string>
    <string name="hamlet_chapter_7">Les jardins des découvertes</string>
    <string name="hamlet_chapter_story_7">Le verre, les plantes et les nouveaux savoirs préparent une plus grande cité.</string>
    <string name="hamlet_chapter_8">Sous les étoiles</string>
    <string name="hamlet_chapter_story_8">Observe le ciel et rapporte des graines rares au village.</string>
    <string name="hamlet_chapter_9">La route des hauteurs</string>
    <string name="hamlet_chapter_story_9">Entraîne tes compagnons, développe tes ateliers et ouvre les hauts plateaux.</string>
    <string name="hamlet_chapter_10">L’académie</string>
    <string name="hamlet_chapter_story_10">Partage les découvertes avec une nouvelle génération d’habitants.</string>
    <string name="hamlet_chapter_11">Un village à célébrer</string>
    <string name="hamlet_chapter_story_11">Fais une place aux fêtes, aux jardins et à tous ceux qui ont fait ce voyage.</string>
