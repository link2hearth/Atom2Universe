    <string name="roguelike_relic_fireball_desc">Inflige %1$s–%2$s dégâts, puis la cible [[state_burn|brûle]] pendant %3$d tours (%19$d %% du coup à chaque tour). Recharge : %4$d tours.</string>
    <string name="roguelike_relic_ice_shard_desc">Inflige %1$s–%2$s dégâts et peut [[state_frozen|geler]] la cible : elle ralentit très fort pendant %18$s tours, et ses coups sont engourdis (plus faibles). Elle résiste parfois — une bonne INT et un swipe réussi l\'en empêchent plus souvent. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_lightning_desc">Inflige %1$s–%2$s dégâts et [[state_paralyzed|paralyse]] la cible pendant %3$d tours : chacune de ses attaques peut tomber à plat (la magie passe quand même). Une bonne INT et un swipe réussi le rendent plus probable. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_venom_desc">Inflige %1$s–%2$s dégâts et ajoute une dose de [[state_poison|poison]] (%17$d au plus) : chaque dose ronge %5$s PV par tour pendant %3$d tours. Recharge : %4$d tours.</string>
    <!-- Le grimoire : reliques du 18/09/2026 (voir DONJON.md, « Le grimoire ») -->
    <string name="roguelike_relic_sunder">Brise-armure</string>
    <string name="roguelike_relic_war_cry">Cri de guerre</string>
    <string name="roguelike_relic_earthquake">Séisme</string>
    <string name="roguelike_relic_hunters_mark">Marque du chasseur</string>
    <string name="roguelike_relic_poisoned_blades">Lames empoisonnées</string>
    <string name="roguelike_relic_freezing_rain">Pluie glacée</string>
    <string name="roguelike_relic_chain_lightning">Chaîne d\'éclairs</string>
    <string name="roguelike_relic_sunder_desc">Inflige %1$s–%2$s dégâts (sans élément) et [[state_fractured|fracture]] la cible pendant %3$d tours : elle prend %9$d %% de dégâts en plus, de tout. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_war_cry_desc">[[state_weakened|Affaiblit]] tous les ennemis pendant %3$d tours (leurs coups font %10$d %% de moins), et tes %16$d prochains coups d\'arme font +%7$d %%. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_earthquake_desc">Inflige %1$s–%2$s dégâts (sans élément) à tous les ennemis, qui chancellent : leur prochain tour recule. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_hunters_mark_desc">Inflige %1$s–%2$s dégâts (sans élément) et [[state_marked|marque]] la cible jusqu\'à sa mort : tes critiques la frappent plus fort, et ton Coup mortel trouve la faille. Quand elle meurt, la marque saute sur un autre ennemi. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_poisoned_blades_desc">Enduit ton arme : chacun de tes %3$d prochains coups d\'arme ajoute une dose de [[state_poison|poison]] (%17$d au plus), qui ronge %5$s PV par tour. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_freezing_rain_desc">Inflige %1$s–%2$s dégâts à tous les ennemis et les [[state_soaked|trempe]] pendant %3$d tours : ils résistent moins au contrôle, et l\'eau réagit avec d\'autres éléments. Elle éteint le feu. Recharge : %4$d tours.</string>
    <string name="roguelike_relic_chain_lightning_desc">Inflige %1$s–%2$s dégâts à la cible, puis saute sur chacun des autres ennemis en perdant %11$d %% à chaque saut. Recharge : %4$d tours.</string>

