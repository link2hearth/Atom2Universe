<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_px_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/project_thumb"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/project_menu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_margin="2dp"
            android:background="@drawable/bg_px_scrim"
            android:contentDescription="@string/px_more"
            android:padding="5dp"
            android:src="@drawable/ic_px_more"
            app:tint="@color/audio_text_primary" />

        <ImageView
            android:id="@+id/project_link_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/px_dot"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_px_link"
            app:tint="?attr/a2uMidiAccentOnText" />

        <ImageView
            android:id="@+id/project_cloud_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/px_dot"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:visibility="gone"
            app:tint="?attr/a2uMidiAccentOnText" />
    </FrameLayout>

    <TextView
        android:id="@+id/project_name"
        style="@style/PxTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/project_info"
        style="@style/PxCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />
</LinearLayout>
