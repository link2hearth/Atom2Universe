<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne du sac : icône, nom (couleur de rareté), type, note et écart avec l'objet porté -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="?selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@+id/inv_item_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:padding="3dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Iron Sword 3" />

        <TextView
            android:id="@+id/inv_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#78909C"
            android:textSize="12sp"
            tools:text="Weapon · Magic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/inv_item_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ECEFF1"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="52" />

        <TextView
            android:id="@+id/inv_item_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="▲ 12" />
    </LinearLayout>
</LinearLayout>
