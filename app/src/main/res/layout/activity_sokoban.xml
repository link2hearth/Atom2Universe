<?xml version="1.0" encoding="utf-8"?>
<!-- Sokoban debout : la bannière porte les actions en icônes (annuler, recommencer, niveau suivant,
     règles), puis la difficulté, les livraisons, le dépôt, les compteurs et les flèches. Le message
     de fin de niveau s'affiche par-dessus le dépôt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uBackgroundColor">

    <com.Atom2Universe.app.util.FitRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/sokoban_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_app_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sokoban_back"
                app:tint="?attr/a2uSecondaryTextColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/sokoban_title"
                android:textColor="?attr/a2uTextColor"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/sokoban_btn_undo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sokoban_undo"
                app:tint="?attr/a2uTextColor" />

            <ImageButton
                android:id="@+id/sokoban_btn_reset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_restart"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sokoban_reset"
                app:tint="?attr/a2uTextColor" />

            <ImageButton
                android:id="@+id/sokoban_btn_new"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sokoban_new"
                app:tint="?attr/a2uTextColor" />

            <ImageButton
                android:id="@+id/sokoban_info_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kit_rules"
                android:padding="10dp"
                android:src="@drawable/ic_info"
                android:tint="?attr/a2uMusicAccent" />
        </LinearLayout>
    </com.Atom2Universe.app.util.FitRow>

    <!-- Le mode (niveaux ou infini) : un seul bouton qui déroule les autres ; en niveaux, le
         bouton du niveau ouvre la grille des niveaux ; le nom du dépôt à droite -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <com.Atom2Universe.app.util.ImmersiveSpinner
            android:id="@+id/sokoban_difficulty_spinner"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/a2uChipBackground"
            android:paddingHorizontal="6dp"
            android:popupBackground="?attr/a2uPopupBackground"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/sokoban_level_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/a2uChipBackground"
            android:drawableEnd="@drawable/ic_expand_more"
            android:drawablePadding="4dp"
            android:drawableTint="?attr/a2uSecondaryTextColor"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/a2uTextColor"
            android:textSize="16sp"
            tools:text="Level 12" />

        <!-- Le nom du dépôt prend la place qui reste et s'efface quand il ne tient pas en entier. -->
        <TextView
            android:id="@+id/sokoban_identity_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/sokoban_identity"
            android:textColor="?attr/a2uMusicAccent"
            android:textSize="12sp"
            android:letterSpacing="0.22" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/sokoban_delivery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="?attr/a2uTextColor"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/sokoban_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?attr/a2uMusicAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Le dépôt, et par-dessus le message de fin de niveau -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.Atom2Universe.app.games.sokoban.SokobanBoardView
            android:id="@+id/sokoban_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <ProgressBar
            android:id="@+id/sokoban_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sokoban_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/a2uPopupBackground"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColor="?attr/a2uTextColor"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Compteurs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/sokoban_moves"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="?attr/a2uSecondaryTextColor"
            android:textSize="13sp"
            tools:text="Moves: 0" />

        <TextView
            android:id="@+id/sokoban_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?attr/a2uMusicAccent"
            android:textSize="13sp"
            tools:text="Best: 24" />

        <TextView
            android:id="@+id/sokoban_pushes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="?attr/a2uSecondaryTextColor"
            android:textSize="13sp"
            tools:text="Pushes: 0" />
    </LinearLayout>

    <!-- Flèches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sokoban_up"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/sokoban_arrow_up"
            android:contentDescription="@string/sokoban_up_label"
            app:cornerRadius="?attr/a2uCorner16"
            app:strokeColor="?attr/a2uOutlineColor"
            app:backgroundTint="?attr/a2uRaisedColor"
            android:textColor="?attr/a2uTextColor" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sokoban_left"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="60dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sokoban_arrow_left"
                android:contentDescription="@string/sokoban_left_label"
                app:cornerRadius="?attr/a2uCorner16"
                app:strokeColor="?attr/a2uOutlineColor"
                app:backgroundTint="?attr/a2uRaisedColor"
                android:textColor="?attr/a2uTextColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sokoban_down"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="60dp"
                android:layout_height="52dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sokoban_arrow_down"
                android:contentDescription="@string/sokoban_down_label"
                app:cornerRadius="?attr/a2uCorner16"
                app:strokeColor="?attr/a2uOutlineColor"
                app:backgroundTint="?attr/a2uRaisedColor"
                android:textColor="?attr/a2uTextColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sokoban_right"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="60dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sokoban_arrow_right"
                android:contentDescription="@string/sokoban_right_label"
                app:cornerRadius="?attr/a2uCorner16"
                app:strokeColor="?attr/a2uOutlineColor"
                app:backgroundTint="?attr/a2uRaisedColor"
                android:textColor="?attr/a2uTextColor" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
