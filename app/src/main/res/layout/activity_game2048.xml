<?xml version="1.0" encoding="utf-8"?>
<!-- 2048 debout : la bannière (retour, titre, nouvelle partie en icône, règles), les trois compteurs,
     une ligne de réglages (grille, objectif, mode quantique), le joker en mode quantique, puis la
     grille. Le message de fin de partie s'affiche par-dessus la grille, le temps de la relance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <com.Atom2Universe.app.util.FitRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_app_back"
                android:tint="@color/audio_text_primary"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/game2048_title"
                android:textSize="22sp"
                android:textColor="@color/startup_text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/game2048_new_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/game2048_new"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="@color/audio_text_primary" />

            <ImageButton
                android:id="@+id/game2048_info_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kit_rules"
                android:padding="10dp"
                android:src="@drawable/ic_info"
                android:tint="?attr/a2uMusicAccent" />
        </LinearLayout>
    </com.Atom2Universe.app.util.FitRow>

    <!-- Les trois compteurs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/game2048_score_label"
                android:textColor="@color/startup_text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/game2048_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/startup_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/game2048_best_label"
                android:textColor="@color/startup_text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/game2048_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0"
                android:textColor="#EDC22E"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/game2048_universes_label"
                android:textColor="@color/startup_text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/game2048_universes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0"
                android:textColor="#7E57C2"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Réglages : grille, objectif, mode quantique (réduits d'un bloc si l'écran est étroit) -->
    <com.Atom2Universe.app.util.FitRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:gravity="center">

            <com.Atom2Universe.app.util.ImmersiveSpinner
                android:id="@+id/game2048_size_spinner"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/a2uChipBackground"
                android:paddingHorizontal="6dp"
                android:popupBackground="?attr/a2uPopupBackground"
                android:spinnerMode="dropdown" />

            <com.Atom2Universe.app.util.ImmersiveSpinner
                android:id="@+id/game2048_target_spinner"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/a2uChipBackground"
                android:paddingHorizontal="6dp"
                android:popupBackground="?attr/a2uPopupBackground"
                android:spinnerMode="dropdown" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/game2048_quantum_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:maxLines="1"
                android:text="@string/game2048_quantum_mode"
                android:textColor="#A78BFA"
                android:textSize="14sp" />
        </LinearLayout>
    </com.Atom2Universe.app.util.FitRow>

    <!-- Le joker, en mode quantique seulement -->
    <Button
        android:id="@+id/game2048_joker_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:maxLines="1"
        android:textSize="14sp"
        android:backgroundTint="#1E293B"
        android:textColor="@color/startup_text_primary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <com.Atom2Universe.app.games.game2048.Game2048View
            android:id="@+id/game2048_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Fin de partie, par-dessus la grille -->
        <TextView
            android:id="@+id/game2048_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/a2uPopupBackground"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColor="@color/startup_text_primary"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
