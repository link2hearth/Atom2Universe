<?xml version="1.0" encoding="utf-8"?>
<!-- Échecs debout : la bannière porte tout (retour, titre, chrono, difficulté, nouvelle partie en
     icône, règles), une ligne dit où en est la partie et montre les pièces prises, et le plateau
     prend le reste. Plus de barre de boutons en bas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <com.Atom2Universe.app.util.FitRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/chess_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_app_back"
                android:tint="@color/audio_text_primary"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/chess_title"
                android:textSize="20sp"
                android:textColor="@color/startup_text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:textColor="@color/startup_text_secondary" />

            <com.Atom2Universe.app.util.ImmersiveSpinner
                android:id="@+id/difficulty_spinner"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/a2uChipBackground"
                android:paddingHorizontal="6dp"
                android:popupBackground="?attr/a2uPopupBackground"
                android:spinnerMode="dropdown" />

            <ImageButton
                android:id="@+id/new_game_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/chess_new_game"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="@color/audio_text_primary" />

            <ImageButton
                android:id="@+id/info_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/kit_rules"
                android:padding="10dp"
                android:src="@drawable/ic_info"
                android:tint="?attr/a2uMusicAccent" />
        </LinearLayout>
    </com.Atom2Universe.app.util.FitRow>

    <!-- Où en est la partie, et les pièces prises -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/startup_text_secondary"
            android:textSize="15sp"
            android:text="@string/chess_status_your_turn" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/captured_pieces_container"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <com.Atom2Universe.app.games.chess.ChessView
            android:id="@+id/chess_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
