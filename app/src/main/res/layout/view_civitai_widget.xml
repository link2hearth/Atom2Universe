<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/a2uSurfaceColor" app:cardCornerRadius="?attr/a2uCorner18"
    app:cardElevation="3dp" app:strokeWidth="1dp" app:strokeColor="?attr/a2uOutlineColor">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="4dp">
        <LinearLayout android:id="@+id/civitai_handle" android:layout_width="240dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
            android:paddingHorizontal="10dp" android:paddingTop="4dp" android:orientation="vertical">
            <TextView android:id="@+id/civitai_count" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                android:gravity="end" android:maxLines="1" android:ellipsize="start"
                android:textColor="?attr/a2uTextColor" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/civitai_back"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/crypto_image_previous" app:srcCompat="@drawable/ic_arrow_back"
                app:tint="?attr/a2uTextColor" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/civitai_next"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/crypto_image_next" app:srcCompat="@drawable/ic_arrow_forward"
                app:tint="?attr/a2uTextColor" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/civitai_accept"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clicker_civitai_save" app:srcCompat="@drawable/ic_check"
                app:tint="?attr/a2uTextColor" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/civitai_reject"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clicker_civitai_hide" app:srcCompat="@drawable/ic_close"
                app:tint="#E45858" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/civitai_more"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/civitai_add_batch" app:srcCompat="@drawable/ic_add"
                app:tint="?attr/a2uTextColor" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
