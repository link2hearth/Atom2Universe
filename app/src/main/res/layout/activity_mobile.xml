<?xml version="1.0" encoding="utf-8"?>
<!-- Toutes les couleurs viennent du thème choisi (fond, bandeaux, accent), comme le sudoku. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">

    <!-- Barre supérieure : retour, difficulté, niveau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="?attr/a2uPanelBackground">

        <ImageButton
            android:id="@+id/mobile_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_app_back"
            app:tint="@color/audio_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/balance_back" />

        <com.Atom2Universe.app.util.ImmersiveSpinner
            android:id="@+id/mobile_difficulty_spinner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="120dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:background="?attr/a2uChipBackground"
            android:popupBackground="?attr/a2uPopupBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/mobile_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/audio_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Scène : le mobile -->
    <com.Atom2Universe.app.games.balance.MobileView
        android:id="@+id/mobile_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp"
        android:background="?attr/a2uPanelBackground">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_btn_restart"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/mobile_btn_restart"
            android:textAllCaps="false"
            android:textColor="@color/audio_text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/audio_surface_raised" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_btn_new"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/balance_btn_new"
            android:textAllCaps="false"
            android:textColor="@color/audio_on_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/a2uMusicAccent" />

    </LinearLayout>

</LinearLayout>
