<?xml version="1.0" encoding="utf-8"?>
<!--
  Le journal d'écoutes d'un appareil. La date de dernière écriture est là pour
  une seule raison : reconnaître un appareil qu'on n'utilise plus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cloud_journal_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/startup_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cloud_journal_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/startup_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/cloud_journal_delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cloud_journal_delete"
        android:src="@drawable/ic_delete"
        app:tint="@color/cloud_danger" />

</LinearLayout>
