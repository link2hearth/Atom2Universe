<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0A24">

    <!-- Bannière -->
    <LinearLayout
        android:id="@+id/link_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#070B1F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/link_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#B8C0F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.06"
            android:text="@string/link_title"
            android:textColor="#B388FF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/link_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4FC3F7"
                android:textSize="13sp"
                tools:text="Étage 7/15" />

            <TextView
                android:id="@+id/link_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C0F0"
                android:textSize="12sp"
                tools:text="1 240 pts" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/link_btn_undo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/link_btn_undo"
            android:padding="8dp"
            android:src="@drawable/ic_undo"
            app:tint="#B8C0F0" />

        <ImageButton
            android:id="@+id/link_btn_restart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/link_btn_restart"
            android:padding="8dp"
            android:src="@drawable/ic_restart"
            app:tint="#B8C0F0" />

    </LinearLayout>

    <!-- Plateau -->
    <com.Atom2Universe.app.games.link.LinkBoardView
        android:id="@+id/link_board_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/link_hand_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/link_header" />

    <!-- La main : les pièces à poser. -->
    <com.Atom2Universe.app.games.link.LinkHandView
        android:id="@+id/link_hand_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#070B1F"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Victoire : par-dessus la main, pour laisser voir la grille apaisée. -->
    <LinearLayout
        android:id="@+id/link_victory_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E6070B1F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/link_victory_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="@string/link_victory_title"
            android:textColor="#E0F7FF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/link_victory_moves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#B8C0F0"
            android:textSize="14sp" />

        <!-- Fin de partie : les points de chaque étage, les parfaits marqués. -->
        <GridLayout
            android:id="@+id/link_run_breakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="5"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/link_victory_new_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#4A2F9E"
            android:text="@string/link_next_floor"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
