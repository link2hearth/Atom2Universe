                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_credit_okhttp_desc"
                        android:textColor="@color/startup_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- FluidSynth -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_credit_fluidsynth_name"
                        android:textColor="@color/startup_text_primary"
