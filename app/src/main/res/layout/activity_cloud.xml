<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/startup_background"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/startup_text_secondary" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/cloud_title"
        android:textColor="@color/startup_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_button"
        app:layout_constraintTop_toTopOf="@id/back_button" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== COMPTE ==================== -->
            <TextView
                style="@style/CloudSectionHeader"
                android:text="@string/cloud_section_account" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CloudCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/cloud_account_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cloud_off"
                            app:tint="@color/startup_text_secondary" />

                        <TextView
                            android:id="@+id/cloud_account_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cloud_not_signed_in"
                            android:textColor="@color/startup_text_primary"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/cloud_sign_in_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cloud_sign_in_hint"
                        android:textColor="@color/startup_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cloud_btn_sign_in_out"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cloud_sign_in" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== SYNCHRONISATION ==================== -->
            <LinearLayout
                android:id="@+id/cloud_sync_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/CloudSectionHeader"
                    android:text="@string/cloud_section_sync" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/CloudCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cloud_sync_enabled"
                                    android:textColor="@color/startup_text_primary"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/cloud_sync_enabled_desc"
                                    android:textColor="@color/startup_text_secondary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/cloud_switch_sync"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/cloud_last_sync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/cloud_last_sync_never"
                            android:textColor="@color/startup_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cloud_btn_sync_now"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/cloud_sync_now" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ==================== SAUVEGARDE ==================== -->
            <LinearLayout
                android:id="@+id/cloud_backup_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/CloudSectionHeader"
                    android:text="@string/music_settings_section_backup" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/CloudCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/cloud_option_primary_device"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/music_settings_primary_device"
                                    android:textColor="@color/startup_text_primary"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/music_settings_primary_device_desc"
                                    android:textColor="@color/startup_text_secondary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/cloud_switch_primary_device"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/cloud_last_backup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/music_settings_last_backup_never"
                            android:textColor="@color/startup_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cloud_btn_backup_restore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/music_settings_restore_backup" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ==================== OCCUPATION ==================== -->
            <LinearLayout
                android:id="@+id/cloud_usage_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CloudSectionHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/cloud_section_usage" />

                    <ImageButton
                        android:id="@+id/cloud_btn_refresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cloud_refresh"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/startup_text_secondary" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/CloudCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/cloud_usage_total"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/cloud_loading"
                            android:textColor="@color/startup_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Barre de proportion : un segment pondéré par domaine,
                             rempli par le code pour rester en phase avec les pastilles. -->
                        <LinearLayout
                            android:id="@+id/cloud_usage_bar"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/cloud_bar_background"
                            android:clipToOutline="true"
                            android:orientation="horizontal" />

                        <ProgressBar
                            android:id="@+id/cloud_progress"
                            style="?android:attr/progressBarStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/cloud_empty_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/cloud_empty"
                            android:textColor="@color/startup_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/cloud_category_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/cloud_usage_hint"
                    android:textColor="@color/startup_text_secondary"
                    android:textSize="12sp" />

                <!-- ==================== JOURNAUX PAR APPAREIL ==================== -->
                <LinearLayout
                    android:id="@+id/cloud_journals_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/CloudSectionHeader"
                        android:text="@string/cloud_section_journals" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/CloudCard">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/cloud_journals_hint"
                                android:textColor="@color/startup_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/cloud_journal_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ==================== DERNIER RECOURS ==================== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cloud_btn_delete_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cloud_delete_all"
                    android:textColor="@color/cloud_danger"
                    app:strokeColor="@color/cloud_danger" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cloud_delete_all_desc"
                    android:textColor="@color/startup_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
