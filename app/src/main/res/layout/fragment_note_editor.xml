<?xml version="1.0" encoding="utf-8"?>
<!-- L'éditeur : la barre du haut, la page (titre, groupe et tags, texte, mentions), puis la barre
     de mise en forme qui reste au-dessus du clavier. Le fond prend la couleur de la note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nt_ed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audio_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/nt_ed_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/nt_ed_back"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_back"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/nt_ed_undo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_undo"
            android:src="@drawable/ic_px_undo" />

        <ImageButton
            android:id="@+id/nt_ed_redo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_redo"
            android:src="@drawable/ic_px_redo" />

        <ImageButton
            android:id="@+id/nt_ed_pin"
            style="@style/PxIconButton"
            android:contentDescription="@string/notes_pin"
            android:src="@drawable/ic_nt_pin" />

        <ImageButton
            android:id="@+id/nt_ed_star"
            style="@style/PxIconButton"
            android:contentDescription="@string/notes_favorite"
            android:src="@drawable/ic_nt_star" />

        <ImageButton
            android:id="@+id/nt_ed_more"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_more"
            android:src="@drawable/ic_px_more" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nt_ed_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/nt_ed_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/notes_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:imeOptions="actionNext"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/audio_text_primary"
                android:textColorHint="@color/audio_text_tertiary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Groupe et tags : des puces, la dernière en ajoute. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-3dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/nt_ed_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp" />
            </HorizontalScrollView>

            <com.Atom2Universe.app.notes.editor.MarkdownEditText
                android:id="@+id/nt_ed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/notes_content_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:minHeight="240dp"
                android:paddingTop="4dp"
                android:textColor="@color/audio_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/nt_ed_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_px_card"
                android:padding="10dp"
                android:textColor="?attr/colorAccent"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Les notes qui citent celle-ci par [[son titre]]. -->
            <LinearLayout
                android:id="@+id/nt_ed_backlinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/nt_ed_backlinks_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/audio_text_tertiary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/nt_ed_backlinks_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/nt_ed_info"
        style="@style/PxCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/audio_text_tertiary" />

    <HorizontalScrollView
        android:id="@+id/nt_ed_toolbar_scroll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/audio_surface"
        android:elevation="?attr/a2uElevation8"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/nt_ed_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>
</LinearLayout>
