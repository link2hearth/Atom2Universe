<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111B27">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/motocross_btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#EBF2F2"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/motocross_hud_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#65E1C2"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/motocross_hud_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:textColor="#EBF2F2"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/motocross_btn_restart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_refresh"
            app:tint="#65E1C2"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/motocross_checkpoint_retry" />

        <ImageButton
            android:id="@+id/motocross_btn_new"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_motocross_new_track"
            app:tint="#F2C36C"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/motocross_new_track" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/motocross_hud_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textColor="#A8BAC7" />
        <TextView
            android:id="@+id/motocross_hud_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#EBF2F2" />
    </LinearLayout>

    <com.Atom2Universe.app.games.motocross.MotocrossView
        android:id="@+id/motocross_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:splitMotionEvents="true"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/motocross_lean_back"
            style="@style/MotocrossControl"
            android:text="@string/motocross_lean_back"
            android:contentDescription="@string/motocross_lean_back_accessibility" />
        <Button
            android:id="@+id/motocross_lean_forward"
            style="@style/MotocrossControl"
            android:text="@string/motocross_lean_forward"
            android:contentDescription="@string/motocross_lean_forward_accessibility" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <Button
            android:id="@+id/motocross_brake"
            style="@style/MotocrossControl"
            android:text="@string/motocross_brake"
            android:contentDescription="@string/motocross_brake_accessibility" />
        <Button
            android:id="@+id/motocross_throttle"
            style="@style/MotocrossControl"
            android:text="@string/motocross_throttle"
            android:textColor="#65E1C2"
            android:contentDescription="@string/motocross_throttle_accessibility" />
    </LinearLayout>
</LinearLayout>
