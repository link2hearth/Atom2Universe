<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/a2uBackgroundColor">

    <!-- Même ciel que le clicker -->
    <com.Atom2Universe.app.crypto.StarfieldView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/circles_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/circles_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/circles_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/a2uMusicAccent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:letterSpacing="0.18"
            android:text="@string/circles_title"
            android:textAllCaps="true"
            android:textColor="?attr/a2uTextColor"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Moves in header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="?attr/a2uChipBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circles_label_moves"
                android:textColor="?attr/a2uSecondaryTextColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/circles_tv_moves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="?attr/a2uTextColor"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Difficulty chips -->
    <HorizontalScrollView
        android:id="@+id/circles_diff_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/circles_header">

        <LinearLayout
            android:id="@+id/circles_diff_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

    </HorizontalScrollView>

    <!-- Bottom section (reward, buttons) pinned to bottom -->
    <LinearLayout
        android:id="@+id/circles_bottom_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Reward -->
        <TextView
            android:id="@+id/circles_tv_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/a2uChipBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="5dp"
            android:textColor="?attr/a2uMusicAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/circles_btn_new"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/circles_btn_new"
                android:textColor="?attr/a2uMusicAccent"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:strokeColor="#667C3AED" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/circles_btn_restart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/circles_btn_restart"
                android:textColor="?attr/a2uMusicAccent"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:strokeColor="#667C3AED" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/circles_btn_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/a2uMusicAccent"
                android:text="@string/circles_btn_hint"
                android:textSize="12sp"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Game canvas (square, fills space between diff row and bottom section) -->
    <com.Atom2Universe.app.games.circles.CirclesView
        android:id="@+id/circles_game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/circles_bottom_section"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/circles_diff_scroll"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Win overlay : voile léger, l'atome en résonance reste visible derrière -->
    <FrameLayout
        android:id="@+id/circles_win_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/a2uSurfaceColor"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/circles_bottom_section"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/circles_diff_scroll">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/circles_win_title"
                android:textColor="?attr/a2uTextColor"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/circles_tv_win_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/a2uMusicAccent"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/circles_btn_again"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/circles_btn_again"
                    android:textColor="?attr/a2uMusicAccent"
                    app:cornerRadius="24dp"
                    app:strokeColor="#667C3AED" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/circles_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/a2uMusicAccent"
                    android:text="@string/circles_btn_next"
                    app:cornerRadius="24dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
