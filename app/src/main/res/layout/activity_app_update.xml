<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="?attr/a2uScreenBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <ImageButton android:id="@+id/update_back" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_app_back" android:tint="@color/audio_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/update_title" android:textSize="24sp" android:textStyle="bold"
            android:layout_marginTop="16dp" android:textColor="@color/audio_text_primary" />
        <TextView android:id="@+id/update_installed" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/audio_text_secondary" />
        <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:accessibilityLiveRegion="polite"
            android:textSize="16sp" android:textColor="@color/audio_text_primary" />
        <ProgressBar android:id="@+id/update_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:max="100" android:visibility="gone" />
        <Button android:id="@+id/update_action" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/update_action" android:visibility="gone" />
        <Button android:id="@+id/update_check" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/update_check" />
        <Button android:id="@+id/update_releases" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/update_releases" />
        <TextView android:id="@+id/update_notes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textIsSelectable="true"
            android:textColor="@color/audio_text_secondary" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
