<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1024">

    <!-- Barre supérieure : retour et état du site -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#101932">

        <ImageButton
            android:id="@+id/trebuchet_btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trebuchet_back" />

        <TextView
            android:id="@+id/trebuchet_best"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFD166"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/trebuchet_btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_settings_24"
            app:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trebuchet_settings" />

    </LinearLayout>

    <!-- La scène, et la bulle à roulettes qui flotte dessus -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.Atom2Universe.app.games.trebuchet.TrebuchetView
            android:id="@+id/trebuchet_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.Atom2Universe.app.games.trebuchet.gears.GearMachineView
            android:id="@+id/trebuchet_gear_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.Atom2Universe.app.games.trebuchet.TrebuchetWheelBubble
            android:id="@+id/trebuchet_wheels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <com.Atom2Universe.app.games.trebuchet.gears.GearEditorBubble
            android:id="@+id/trebuchet_gear_editor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

    </FrameLayout>

    <!--
        Le bandeau du bas : le sol de l'aire de jeu qui continue sous la scène. Textes et
        boutons sont posés dessus, ce qui les rattache au terrain au lieu d'en faire une
        barre d'application collée en dessous.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_trebuchet_ground">

        <!-- Message d'état -->
        <TextView
            android:id="@+id/trebuchet_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:textColor="#A8BFA4"
            android:textSize="12sp" />

        <!-- La pièce tenue en main : ce qu'elle vaut, et ce qu'elle échange -->
        <TextView
            android:id="@+id/trebuchet_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:textColor="#FFD166"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trebuchet_info_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:textColor="#A8BFA4"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Boutons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/trebuchet_btn_machines"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/trebuchet_btn_machines"
                android:textColor="#C7D8C0"
                android:textSize="13sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp"
                android:background="@drawable/bg_trebuchet_button"
                android:clickable="true"
                android:focusable="true" />

            <!-- Choisir une pièce par son nom : voir TrebuchetActivity.showPartsMenu -->
            <TextView
                android:id="@+id/trebuchet_btn_parts"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/trebuchet_btn_parts"
                android:textColor="#C7D8C0"
                android:textSize="13sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp"
                android:background="@drawable/bg_trebuchet_button"
                android:clickable="true"
                android:focusable="true" />

            <!-- Avance rapide : visible en mode engrenages seulement, voir
                 TrebuchetActivity.applyMode. Le trébuchet n'a rien à charger. -->
            <TextView
                android:id="@+id/trebuchet_btn_time"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/trebuchet_btn_time"
                android:textColor="#C7D8C0"
                android:textSize="13sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="13sp"
                android:background="@drawable/bg_trebuchet_button"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/trebuchet_btn_fire"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/trebuchet_btn_release"
                android:textColor="#F1F7EC"
                android:textSize="14sp"
                android:textStyle="bold"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="14sp"
                android:background="@drawable/bg_trebuchet_button_main"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
