<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1024">

    <!-- Barre supérieure : retour et record -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="#101932">

        <ImageButton
            android:id="@+id/trebuchet_btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trebuchet_back" />

        <TextView
            android:id="@+id/trebuchet_specs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="#8FA6C8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/trebuchet_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFD166"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- La scène, et la bulle à roulettes qui flotte dessus -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.Atom2Universe.app.games.trebuchet.TrebuchetView
            android:id="@+id/trebuchet_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.Atom2Universe.app.games.trebuchet.TrebuchetWheelBubble
            android:id="@+id/trebuchet_wheels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Message d'état -->
    <TextView
        android:id="@+id/trebuchet_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:textColor="#8FA6C8"
        android:textSize="12sp" />

    <!-- La pièce tenue en main : ce qu'elle vaut, et ce qu'elle échange -->
    <TextView
        android:id="@+id/trebuchet_info_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:textColor="#FFD166"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trebuchet_info_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:textColor="#8FA6C8"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:id="@+id/trebuchet_btn_machines"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/trebuchet_btn_machines"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:background="@drawable/bg_widget_arrow"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/trebuchet_btn_fire"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="2"
            android:gravity="center"
            android:text="@string/trebuchet_btn_release"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_arrow"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
