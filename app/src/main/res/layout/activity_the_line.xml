<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#041A12">

    <!-- Plateau : il peint aussi le vernis décoré autour de la carte. -->
    <com.Atom2Universe.app.games.theline.TheLineBoardView
        android:id="@+id/the_line_board"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/the_line_chip_scroll" />

    <!-- Bannière -->
    <LinearLayout
        android:id="@+id/the_line_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#07281C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/the_line_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/the_line_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#B9D3C4" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="@string/the_line_title"
            android:textColor="#E9A869"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/the_line_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#FFD66B"
            android:textSize="14sp"
            tools:text="Niveau 12" />

        <ImageButton
            android:id="@+id/the_line_btn_reset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/the_line_clear_desc"
            android:padding="8dp"
            android:src="@drawable/ic_restart"
            app:tint="#B9D3C4" />

    </LinearLayout>

    <!-- Mode et difficulté -->
    <HorizontalScrollView
        android:id="@+id/the_line_chip_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#07281C"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/the_line_header">

        <LinearLayout
            android:id="@+id/the_line_chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingBottom="4dp" />

    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/the_line_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/the_line_board"
        app:layout_constraintEnd_toEndOf="@id/the_line_board"
        app:layout_constraintStart_toStartOf="@id/the_line_board"
        app:layout_constraintTop_toTopOf="@id/the_line_board" />

    <!-- Victoire : en bas, pour laisser voir le circuit sous tension. -->
    <LinearLayout
        android:id="@+id/the_line_win_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E6041A12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/the_line_win_title"
            android:textColor="#FFD66B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/the_line_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#B9D3C4"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/the_line_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#8A5326"
            android:text="@string/the_line_next"
            android:textColor="#FFF1C2" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
