<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09171E">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/pipetap_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#142831"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/pipetap_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/color_stack_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#ABC2C6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/pipetap_title"
            android:textColor="#E2E8F0"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Stats : moves + time -->
        <TextView
            android:id="@+id/pipetap_moves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="#ABC2C6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pipetap_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="#ABC2C6"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Difficulty chips -->
    <HorizontalScrollView
        android:id="@+id/pipetap_diff_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pipetap_header">

        <LinearLayout
            android:id="@+id/pipetap_diff_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/pipetap_status_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@drawable/pipetap_console_panel"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/pipetap_diff_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pipetap_station"
            android:textColor="#C99C59"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/pipetap_flow_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#D9EEEB"
            android:textSize="13sp" />
        <ProgressBar
            android:id="@+id/pipetap_flow_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:progressTint="#37DACB"
            android:progressBackgroundTint="#35515A" />
    </LinearLayout>
    <!-- Game view -->
    <com.Atom2Universe.app.games.pipetap.PipeTapView
        android:id="@+id/pipetap_game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pipetap_status_panel" />

    <!-- Win overlay -->
    <FrameLayout
        android:id="@+id/pipetap_win_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#BB09171E"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pipetap_diff_scroll">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/pipetap_console_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pipetap_solved"
                android:textColor="#37DACB"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pipetap_win_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pipetap_btn_again"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/pipetap_btn_again"
                    android:textColor="#ABC2C6" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pipetap_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pipetap_btn_next"
                    android:textColor="#09171E"
                    android:backgroundTint="#37DACB" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
