<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A1C">

    <!-- Bannière -->
    <LinearLayout
        android:id="@+id/sb_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/sb_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="#C8C4E8" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/starbridges_title"
            android:textColor="#FFD27A"
            android:textSize="18sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/sb_stat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#9A9CC0"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/sb_atlas_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/starbridges_atlas_title"
            android:padding="8dp"
            android:src="@drawable/ic_constellation_atlas"
            app:tint="#FFD27A" />

        <ImageButton
            android:id="@+id/sb_restart_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/starbridges_restart_desc"
            android:padding="8dp"
            android:src="@drawable/ic_restart"
            app:tint="#C8C4E8" />

    </LinearLayout>

    <!-- Tailles de grille -->
    <HorizontalScrollView
        android:id="@+id/sb_size_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sb_header">

        <LinearLayout
            android:id="@+id/sb_size_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

    </HorizontalScrollView>

    <!-- Plateau -->
    <com.Atom2Universe.app.games.starbridges.StarBridgesBoardView
        android:id="@+id/sb_board"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sb_size_scroll" />

    <!-- Résultat : en bas, pour laisser voir la constellation qu'on vient de tracer. -->
    <LinearLayout
        android:id="@+id/sb_win_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#D8060A1C"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/sb_win_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFD27A"
            android:textSize="26sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/sb_win_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#9A9CC0"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sb_btn_atlas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/starbridges_btn_atlas"
                android:textColor="#FFD27A"
                app:strokeColor="#80FFD27A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sb_btn_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#3A2F6E"
                android:text="@string/starbridges_btn_again" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
