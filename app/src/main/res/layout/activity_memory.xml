<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <!-- Une seule bannière : retour, coups, temps, taille (bouton bulle), zoom, règles. -->
    <LinearLayout
        android:id="@+id/memory_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="?attr/a2uPanelBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/memory_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/memory_btn_back"
            android:padding="10dp"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary" />

        <TextView
            android:id="@+id/memory_flips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/audio_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/memory_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/audio_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/memory_size_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:textAllCaps="false"
            android:textColor="@color/audio_on_accent"
            android:textSize="15sp"
            app:backgroundTint="?attr/a2uMusicAccent"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="end"
            app:iconPadding="2dp"
            app:iconSize="20dp"
            app:iconTint="@color/audio_on_accent" />

        <ImageButton
            android:id="@+id/memory_zoom_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/memory_pop_cards"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_zoom"
            android:tint="@color/audio_text_primary" />

        <ImageButton
            android:id="@+id/memory_info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            android:tint="?attr/a2uMusicAccent" />

    </LinearLayout>

    <!-- Card grid — full space below the header -->
    <HorizontalScrollView
        android:id="@+id/memory_board_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_header">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/memory_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

    </HorizontalScrollView>

    <!-- Couche de la carte agrandie : ne prend aucune touche, le plateau reste jouable. -->
    <FrameLayout
        android:id="@+id/memory_pop_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_header" />

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/memory_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Win overlay -->
    <FrameLayout
        android:id="@+id/memory_win_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/a2uSurfaceColor"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_solved"
                android:textColor="?attr/a2uMusicAccent"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memory_win_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/a2uTextColor"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memory_btn_again"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/memory_btn_again"
                android:textColor="@color/audio_text_secondary" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
