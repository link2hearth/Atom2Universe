<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">

    <!-- Barre supérieure : retour, difficulté, niveau, vider, nouveau, règles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="?attr/a2uPanelBackground">

        <ImageButton
            android:id="@+id/balance_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/a2uSecondaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/balance_back" />

        <com.Atom2Universe.app.util.ImmersiveSpinner
            android:id="@+id/balance_difficulty_spinner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:popupBackground="?attr/a2uPopupBackground" />

        <TextView
            android:id="@+id/balance_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/a2uSecondaryTextColor"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/balance_btn_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_restart"
            app:tint="?attr/a2uSecondaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/balance_btn_reset"
            android:tooltipText="@string/balance_btn_reset" />

        <ImageButton
            android:id="@+id/balance_btn_new"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/a2uSecondaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/balance_btn_new"
            android:tooltipText="@string/balance_btn_new" />

        <ImageButton
            android:id="@+id/balance_btn_info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:padding="10dp"
            android:src="@drawable/ic_info"
        android:tint="?attr/a2uMusicAccent" />

    </LinearLayout>

    <!-- Scène : plateau de poids en haut, balance en bas ; le verdict s'affiche par-dessus. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.Atom2Universe.app.games.balance.BalanceView
            android:id="@+id/balance_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/balance_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:textColor="?attr/a2uTextColor"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
