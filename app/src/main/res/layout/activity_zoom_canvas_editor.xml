<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audio_background">

    <!-- Barre du haut : retour, titre, annuler / rétablir, menu -->
    <LinearLayout
        android:id="@+id/zc_top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/audio_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/zc_btn_back"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_back"
            android:src="@drawable/ic_px_back" />

        <LinearLayout
            android:id="@+id/zc_title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/zc_title"
                style="@style/PxTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/zc_subtitle"
                style="@style/PxCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/zc_btn_undo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_undo"
            android:src="@drawable/ic_px_undo" />

        <ImageButton
            android:id="@+id/zc_btn_redo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_redo"
            android:src="@drawable/ic_px_redo" />

        <ImageButton
            android:id="@+id/zc_btn_more"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_more"
            android:src="@drawable/ic_px_more" />
    </LinearLayout>

    <!-- La toile -->
    <com.Atom2Universe.app.zoomcanvas.ZoomCanvasView
        android:id="@+id/zc_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/zc_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zc_top_bar" />

    <!-- Pastille de niveau : où je suis dans la pile des couches ; un appui liste les couches dessinées -->
    <LinearLayout
        android:id="@+id/zc_level_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:alpha="0.85"
        android:background="@drawable/bg_px_chip"
        android:elevation="4dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:minWidth="84dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zc_top_bar">

        <TextView
            android:id="@+id/zc_level_text"
            style="@style/PxCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/audio_text_primary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/zc_level_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:importantForAccessibility="no"
            android:max="1000" />
    </LinearLayout>

    <!-- Outils -->
    <HorizontalScrollView
        android:id="@+id/zc_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/audio_surface"
        android:elevation="6dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/zc_tools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/zc_message"
        style="@style/PxCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_px_chip"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:singleLine="false"
        android:textColor="@color/audio_text_primary"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/zc_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
