<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audio_background">

    <!-- Barre du haut : retour, titre, annuler / rétablir, menu (comme le pixel art) -->
    <LinearLayout
        android:id="@+id/zc_top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/audio_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/zc_btn_back"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_back"
            android:src="@drawable/ic_px_back" />

        <LinearLayout
            android:id="@+id/zc_title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/zc_title"
                style="@style/PxTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/zc_subtitle"
                style="@style/PxCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Cadenas : bloque le zoom, deux doigts ne font plus que déplacer la vue -->
        <ImageButton
            android:id="@+id/zc_btn_lock"
            style="@style/PxIconButton"
            android:contentDescription="@string/zc_zoom_lock"
            android:src="@drawable/ic_px_unlock" />

        <ImageButton
            android:id="@+id/zc_btn_undo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_undo"
            android:src="@drawable/ic_px_undo" />

        <ImageButton
            android:id="@+id/zc_btn_redo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_redo"
            android:src="@drawable/ic_px_redo" />

        <ImageButton
            android:id="@+id/zc_btn_more"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_more"
            android:src="@drawable/ic_px_more" />
    </LinearLayout>

    <!-- La toile -->
    <com.Atom2Universe.app.zoomcanvas.ZoomCanvasView
        android:id="@+id/zc_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/zc_bottom_stack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zc_top_bar" />

    <!-- Pastille de niveau : où je suis dans la pile des couches ; un appui liste les couches dessinées -->
    <LinearLayout
        android:id="@+id/zc_level_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_px_chip"
        android:elevation="4dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:minWidth="84dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/zc_bottom_stack"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/zc_level_text"
            style="@style/PxCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/audio_text_primary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/zc_level_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:importantForAccessibility="no"
            android:max="1000" />
    </LinearLayout>

    <TextView
        android:id="@+id/zc_message"
        style="@style/PxCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_px_chip"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:singleLine="false"
        android:textColor="@color/audio_text_primary"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/zc_level_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Réglage de couleur : carte flottante au-dessus du pied, repliée par défaut -->
    <com.Atom2Universe.app.pixelart.ui.ColorDock
        android:id="@+id/zc_color_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/zc_bottom_stack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="340dp" />

    <!-- Pied : outils (les réglages de l'outil choisi juste à côté de son bouton), puis couleurs -->
    <LinearLayout
        android:id="@+id/zc_bottom_stack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/audio_surface"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:id="@+id/zc_tools_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/zc_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/px_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="42dp">

                <com.Atom2Universe.app.pixelart.ui.SwatchView
                    android:id="@+id/zc_swatch_secondary"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/px_color_secondary" />

                <com.Atom2Universe.app.pixelart.ui.SwatchView
                    android:id="@+id/zc_swatch_primary"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:contentDescription="@string/px_color_primary" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/zc_btn_swap"
                style="@style/PxIconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/px_color_swap"
                android:padding="7dp"
                android:src="@drawable/ic_px_flip_h" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/zc_palette_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <ImageButton
                android:id="@+id/zc_btn_palette"
                style="@style/PxIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/px_palette"
                android:padding="9dp"
                android:src="@drawable/ic_px_palette" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
