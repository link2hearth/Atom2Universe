<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#111A33">

    <LinearLayout
        android:id="@+id/infernale_item_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/infernale_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infernale_item_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/infernale_item_rename"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="✎"
        android:textColor="#CBD5E1"
        android:textSize="18sp"
        android:contentDescription="@string/infernale_rename"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <TextView
        android:id="@+id/infernale_item_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#E05555"
        android:textSize="18sp"
        android:contentDescription="@string/infernale_delete"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
