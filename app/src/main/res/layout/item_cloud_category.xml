<?xml version="1.0" encoding="utf-8"?>
<!--
  Une ligne de l'inventaire cloud : pastille de couleur, nom du domaine et ce
  qu'il contient, sa taille, et le bouton de suppression. La pastille reprend
  exactement la couleur du segment de la barre de proportion, c'est ce qui
  permet de relier les deux d'un coup d'œil.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/cloud_cat_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/cloud_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cloud_cat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/startup_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cloud_cat_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/startup_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cloud_cat_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/startup_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/cloud_cat_delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cloud_delete"
        android:src="@drawable/ic_delete"
        app:tint="@color/cloud_danger" />

</LinearLayout>
