<?xml version="1.0" encoding="utf-8"?>
<!-- Inventaire du Donjon : équipement porté, caractéristiques, sac infini trié, détail d'un objet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roguelike_inventory"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20A0F18"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- En-tête : titre, or, fermer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/roguelike_equipment_title"
            android:textColor="#DDDDDD"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inv_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#FFD600"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="120 gold" />

        <ImageButton
            android:id="@+id/inv_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/roguelike_inventory_close"
            android:src="@drawable/ic_close"
            app:tint="#CCCCCC"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <!-- Les 7 emplacements portés (remplis dans le code) -->
    <LinearLayout
        android:id="@+id/inv_equipped"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/inv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FF141E2A"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:textColor="#CFD8DC"
        android:textSize="12sp" />

    <!-- Sac : nombre d'objets + tri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inv_bag_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#90A4AE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/inv_sort_best"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/roguelike_inventory_sort_best"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/inv_sort_recent"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/roguelike_inventory_sort_recent"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inv_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/inv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/roguelike_inventory_empty"
        android:textColor="#607D8B"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Détail de l'objet choisi -->
    <LinearLayout
        android:id="@+id/inv_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FF141E2A"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/inv_detail_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inv_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inv_detail_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#78909C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/inv_detail_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#A5D6A7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/inv_detail_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/inv_detail_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inv_detail_equip"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#FF1565C0"
                android:gravity="center"
                android:text="@string/roguelike_loot_equip_btn"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/inv_detail_sell"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#FF6D4C1F"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
