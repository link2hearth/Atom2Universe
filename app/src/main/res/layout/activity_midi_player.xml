<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/a2uScreenBackground"
    tools:context=".midi.ui.MidiPlayerActivity">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <!-- Bannière : flèche retour + onglets (plus de titre) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/a2uPanelBackground"
        android:elevation="?attr/a2uElevation2"
        app:contentInsetStart="4dp"
        app:contentInsetEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">
        <tag android:id="@id/app_effects_banner" android:value="true" />

        <!-- Retour : clic = remonter d'un niveau (ou quitter à la racine), appui long 1,5 s = quitter -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/canvas_back" />

        <HorizontalScrollView
            android:id="@+id/audio_midi_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                android:id="@+id/tab_library"
                android:minHeight="44dp"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/midi_nav_library"
                android:textColor="?attr/a2uMidiAccent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:background="?attr/a2uTabBackground" />

            <TextView
                android:id="@+id/tab_playlists"
                android:minHeight="44dp"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/midi_nav_playlists"
                android:textColor="@color/audio_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:background="?attr/a2uTabBackground" />

            <TextView
                android:id="@+id/tab_now_playing"
                android:minHeight="44dp"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/midi_nav_now_playing"
                android:textColor="@color/audio_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:background="?attr/a2uTabBackground" />

            <TextView
                android:id="@+id/tab_practice"
                android:minHeight="44dp"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/midi_nav_practice"
                android:textColor="@color/audio_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:background="?attr/a2uTabBackground" />

            </LinearLayout>

        </HorizontalScrollView>

    </androidx.appcompat.widget.Toolbar>

    <!-- ViewPager2 pour les fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/a2uScreenBackground"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/playback_bar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Container pour le mode pratique (overlay plein écran) -->
    <FrameLayout
        android:id="@+id/practice_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="?attr/a2uElevation8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Playback Bar (visible on Library and Playlists tabs) -->
    <LinearLayout
        android:id="@+id/playback_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/a2uPanelBackground"
        android:elevation="?attr/a2uElevation8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        android:clipToOutline="true">

        <!-- Track info (clickable to go to Now Playing) -->
        <LinearLayout
            android:id="@+id/playback_bar_track_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playback_bar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/midi_no_track_playing"
                    android:textColor="@color/audio_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/playback_bar_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/audio_text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="Artist Name"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Seek bar with time labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <SeekBar
                android:id="@+id/playback_bar_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:progressTint="?attr/a2uMidiAccent"
                android:thumbTint="?attr/a2uMidiAccent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/playback_bar_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/audio_text_secondary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/playback_bar_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/audio_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Playback controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <!-- Shuffle button -->
            <ImageButton
                android:id="@+id/playback_bar_shuffle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shuffle"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/audio_text_secondary"
                android:contentDescription="@string/midi_action_shuffle"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <!-- Previous button -->
            <ImageButton
                android:id="@+id/playback_bar_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_skip_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/audio_text_primary"
                android:contentDescription="@string/midi_action_previous" />

            <!-- Stop button -->
            <ImageButton
                android:id="@+id/playback_bar_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_stop"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/audio_text_primary"
                android:contentDescription="@string/audio_action_stop"
                android:scaleType="centerInside"
                android:padding="8dp" />

            <!-- Play/Pause button -->
            <ImageButton
                android:id="@+id/playback_bar_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:src="@drawable/ic_play"
                android:background="?attr/a2uControlBackground"
                app:tint="@color/audio_on_accent"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="@string/audio_hub_play_pause" />

            <!-- Next button -->
            <ImageButton
                android:id="@+id/playback_bar_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_skip_next"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/audio_text_primary"
                android:contentDescription="@string/midi_action_next" />

            <!-- Repeat button -->
            <ImageButton
                android:id="@+id/playback_bar_repeat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_repeat"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/audio_text_secondary"
                android:contentDescription="@string/midi_action_repeat"
                android:scaleType="centerInside"
                android:padding="6dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
