<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <LinearLayout
        android:id="@+id/lib_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        style="@style/A2ULibraryHeader"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <tag android:id="@id/app_effects_banner" android:value="true" />

        <ImageButton
            android:id="@+id/lib_btn_back"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_back"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary" />

        <TextView
            style="@style/PxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ae_library_title"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/lib_btn_more"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_more"
            android:src="@drawable/ic_px_more" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lib_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lib_top_bar" />

    <LinearLayout
        android:id="@+id/lib_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lib_top_bar">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_waveform"
            app:tint="@color/audio_text_tertiary" />

        <TextView
            style="@style/PxTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:singleLine="false"
            android:text="@string/ae_library_empty"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        style="@style/A2ULibraryNewButton"
        android:id="@+id/lib_fab_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/ae_new"
        android:textColor="?attr/a2uMidiAccentOnText"
        app:backgroundTint="?attr/colorAccent"
        app:icon="@drawable/ic_px_add"
        app:iconTint="?attr/a2uMidiAccentOnText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
