<?xml version="1.0" encoding="utf-8"?>
<!-- Le lexique du Donjon : la liste par catégories, ou une fiche (remplie dans le code, voir LexiconPanel) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roguelike_lexicon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F60A0F18"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lex_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingEnd="16dp"
            android:text="@string/lex_back"
            android:textColor="#64B5F6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lex_title"
            android:textColor="#DDDDDD"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/lex_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="#FF141E2A"
        android:hint="@string/lex_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#607D8B"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/lex_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/lex_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
