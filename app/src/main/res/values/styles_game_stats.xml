<resources>
    <style name="GameStatSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/a2uMusicAccent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="GameStatRow" parent="StatRow">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="GameStatLabel" parent="StatLabel">
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="GameStatValue" parent="StatValue">
        <item name="android:maxWidth">150dp</item>
    </style>
</resources>
