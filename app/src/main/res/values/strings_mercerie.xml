    <string name="mercerie_tuto_line">Scissors</string>
    <string name="mercerie_tuto_line_make">Swipe the heart to line up 4 hearts: they turn into scissors.</string>
    <string name="mercerie_tuto_line_use">Match the scissors with 2 hearts: they cut their whole column.</string>
    <string name="mercerie_tuto_bomb">Pom-pom</string>
    <string name="mercerie_tuto_bomb_make">Line up hearts in an L, 3 one way and 3 the other: a pom-pom.</string>
    <string name="mercerie_tuto_bomb_use">Match the pom-pom: it bursts all around, twice.</string>
    <string name="mercerie_tuto_rainbow">Rainbow button</string>
    <string name="mercerie_tuto_rainbow_make">Line up 5 hearts: a rainbow button.</string>
    <string name="mercerie_tuto_rainbow_use">Swap it with a yarn ball: every yarn ball goes.</string>
    <string name="mercerie_tuto_butterfly">Butterfly</string>
    <string name="mercerie_tuto_butterfly_make">Make a square of 4 hearts: a butterfly.</string>
    <string name="mercerie_tuto_butterfly_use">Match the butterfly: it flies off to undo what is in the way, here the knot.</string>
    <string name="mercerie_tuto_cross">Scissors + scissors</string>
    <string name="mercerie_tuto_cross_use">Swap the two scissors: a row and a column at once.</string>
    <string name="mercerie_tuto_line_bomb">Scissors + pom-pom</string>
    <string name="mercerie_tuto_line_bomb_use">Swap them: three rows and three columns cut.</string>
    <string name="mercerie_tuto_big_bomb">Pom-pom + pom-pom</string>
    <string name="mercerie_tuto_big_bomb_use">Swap the two pom-poms: a huge burst, twice.</string>
    <string name="mercerie_tuto_rainbow_line">Rainbow + scissors</string>
    <string name="mercerie_tuto_rainbow_line_use">Swap them: every piece of the scissors\' colour turns into scissors.</string>
    <string name="mercerie_tuto_rainbow_bomb">Rainbow + pom-pom</string>
    <string name="mercerie_tuto_rainbow_bomb_use">Swap them: every piece of the pom-pom\'s colour turns into a pom-pom.</string>
    <string name="mercerie_tuto_butterfly_line">Butterfly + scissors</string>
    <string name="mercerie_tuto_butterfly_line_use">Swap them: the butterfly carries the scissors to the knot.</string>
    <string name="mercerie_tuto_double_rainbow">Rainbow + rainbow</string>
    <string name="mercerie_tuto_double_rainbow_use">Swap the two rainbows: the whole board goes.</string>
    <string name="mercerie_tuto_chain">Chain reaction</string>
    <string name="mercerie_tuto_chain_use">Match the scissors: they hit the pom-pom, which hits more scissors, which hit the rainbow.</string>
