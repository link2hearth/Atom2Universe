    <!-- Tutoriel -->
    <string name="mercerie_tutorial">Tutorial</string>
    <string name="mercerie_tuto_count">%1$d / %2$d</string>
    <string name="mercerie_tuto_your_turn">Your turn: do it again on your own!</string>
    <string name="mercerie_tuto_your_turn_combo">Two brand-new bonuses: your turn to swap them!</string>
    <string name="mercerie_tuto_well_done">Well done! Keep playing as you like.</string>
    <string name="mercerie_tuto_free">Your turn: make bonuses and set them off against each other.</string>
