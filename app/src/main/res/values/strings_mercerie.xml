    <string name="mercerie_off">Off</string>
    <string name="mercerie_help_title">How to play</string>
    <string name="mercerie_help_line">4 in a row: a bobbin that clears a whole line.</string>
    <string name="mercerie_help_bomb">An L or a T: a pom-pom that bursts twice.</string>
    <string name="mercerie_help_rainbow">5 in a row: the rainbow button takes away one colour.</string>
    <string name="mercerie_help_patch">Patch: match on top of it to unpick it.</string>
    <string name="mercerie_help_knot">Wool knot: match right next to it to undo it.</string>
    <string name="mercerie_help_pin">Pin: the piece stays stuck until it is matched.</string>
    <string name="mercerie_help_thimble">Thimble: bring it all the way down.</string>
    <string name="mercerie_help_combo">Swap two bonus pieces together for a bigger effect.</string>
