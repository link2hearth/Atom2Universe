        <item quantity="one">" (%1$d change)"</item>
        <item quantity="other">" (%1$d changes)"</item>
    </plurals>

    <!-- Mode hybride : résumé de la sélection -->
    <plurals name="midi_ui_hybrid_summary">
        <item quantity="one">%1$d instrument uses SF2</item>
        <item quantity="other">%1$d instruments use SF2</item>
    </plurals>
    <plurals name="midi_ui_hybrid_summary_drums">
        <item quantity="one">%1$d instrument and the drums use SF2</item>
        <item quantity="other">%1$d instruments and the drums use SF2</item>
    </plurals>

    <!-- Rapport de vérification d'une SoundFont, en mots simples -->
    <string name="midi_ui_sf2_report_contents">This SoundFont holds %1$s, made from %2$s.</string>
    <plurals name="midi_ui_sf2_report_presets">
        <item quantity="one">%1$d instrument</item>
        <item quantity="other">%1$d instruments</item>
    </plurals>
    <plurals name="midi_ui_sf2_report_samples">
        <item quantity="one">%1$d recorded sound</item>
        <item quantity="other">%1$d recorded sounds</item>
    </plurals>
    <string name="midi_ui_sf2_report_fine">No problem found: this SoundFont looks fine.</string>
    <string name="midi_ui_sf2_issue_no_presets">It contains no instrument: nothing can be played.</string>
    <string name="midi_ui_sf2_issue_no_samples">It contains no recorded sound: it will stay silent.</string>
    <string name="midi_ui_sf2_issue_no_instruments">Its instruments are missing: it will stay silent.</string>
    <plurals name="midi_ui_sf2_issue_stretched">
        <item quantity="one">%1$d note is played too far from the pitch it was recorded at: some instruments may sound wrong.</item>
        <item quantity="other">%1$d notes are played too far from the pitch they were recorded at: some instruments may sound wrong.</item>
    </plurals>
    <plurals name="midi_ui_sf2_issue_suspicious">
        <item quantity="one">%1$d instrument looks oddly built: it may not sound as expected.</item>
        <item quantity="other">%1$d instruments look oddly built: they may not sound as expected.</item>
    </plurals>
    <plurals name="midi_ui_sf2_issue_invalid_samples">
        <item quantity="one">%1$d recorded sound has wrong settings and may play badly:</item>
        <item quantity="other">%1$d recorded sounds have wrong settings and may play badly:</item>
    </plurals>
    <string name="midi_ui_sf2_report_item">• %1$s</string>
    <plurals name="midi_ui_sf2_report_more">
        <item quantity="one">…and %1$d more</item>
        <item quantity="other">…and %1$d more</item>
    </plurals>
    <string name="midi_ui_sf2_report_details_title">Instruments to check:</string>
    <plurals name="midi_ui_sf2_warning_stretched">
        <item quantity="one">“%1$s”: %2$d note too far from its recording</item>
        <item quantity="other">“%1$s”: %2$d notes too far from their recording</item>
    </plurals>
    <string name="midi_ui_sf2_warning_mismatch">“%1$s” uses the sound “%2$s”, which may not match</string>
</resources>
