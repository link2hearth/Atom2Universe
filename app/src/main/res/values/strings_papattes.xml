    <string name="papattes_title">Lanky Paws</string>
    <string name="papattes_description">Walk, hop or skate a wobbly critter to the flag, then hatch and breed new ones in the lab.</string>
    <string name="papattes_touch_description">Hold anywhere and let go to move your critter</string>
