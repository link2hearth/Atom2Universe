    <string name="roguelike_attr_desc_str">Strength — weapon damage: +%1$d%% per point above 10.</string>
    <string name="roguelike_attr_desc_dex">Dexterity — critical chance, a wider parry window, dodge (except in heavy armor), and the power of Venom.</string>
    <string name="roguelike_attr_desc_con">Constitution — hit points: +%1$d per point above 10.</string>
    <string name="roguelike_attr_desc_int">Intelligence — fire, ice and lightning spells: +%1$d%% damage per point above 10, and they freeze or paralyze more often.</string>
    <string name="roguelike_attr_desc_wis">Wisdom — relics and the Special recharge faster: one turn less every %1$d points above 10.</string>
    <string name="roguelike_attr_desc_cha">Charisma — gold found: +%1$d%% per point above 10.</string>
