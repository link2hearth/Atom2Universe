    <!-- Domaines -->
    <string name="cloud_cat_listens">Listen history</string>
    <string name="cloud_cat_listens_desc">One journal per device, feeding your play counts</string>
    <string name="cloud_cat_listens_warning">Play counts already merged on your devices are kept. Each device republishes its own journal at its next sync — but only devices you still use.</string>

    <string name="cloud_cat_music">Music library</string>
    <string name="cloud_cat_music_desc">Favourites, lyrics, playlists, equaliser presets</string>
    <string name="cloud_cat_music_warning">Your devices keep their local copies and will republish them. A device that is retired loses what only it held.</string>

    <string name="cloud_cat_artist_images">Artist artwork</string>
    <string name="cloud_cat_artist_images_desc">Custom images for your favourite artists</string>
    <string name="cloud_cat_artist_images_warning">Usually the heaviest item. Images still on a device are re-uploaded; the others are lost.</string>

    <string name="cloud_cat_games">Game saves</string>
    <string name="cloud_cat_games_desc">Clicker, neutrinos, achievements, game progress</string>
    <string name="cloud_cat_games_warning">Your progress on this device is untouched and will be republished. Progress that exists only in the cloud is lost.</string>

    <string name="cloud_cat_reading">Reading progress</string>
    <string name="cloud_cat_reading_desc">Where you are in your books and comics</string>
    <string name="cloud_cat_reading_warning">Bookmarks on this device are kept. Those coming from another device are lost until that device syncs again.</string>

    <string name="cloud_cat_stats">Usage stats</string>
    <string name="cloud_cat_stats_desc">Time spent per module, across devices</string>
    <string name="cloud_cat_stats_warning">History gathered from your other devices is lost. This device republishes its own.</string>

    <string name="cloud_cat_backup">Backup</string>
    <string name="cloud_cat_backup_desc">Full snapshot published by the primary device</string>
    <string name="cloud_cat_backup_warning">You lose the ability to restore a fresh install from the cloud. Day-to-day syncing is unaffected.</string>

    <string name="cloud_cat_obsolete">Obsolete files</string>
    <string name="cloud_cat_obsolete_desc">Left over from an older sync format</string>
    <string name="cloud_cat_obsolete_warning">Nothing reads these any more. Deleting them is safe.</string>

    <string name="cloud_cat_unknown">Unrecognised</string>
    <string name="cloud_cat_unknown_desc">Files this screen does not know about</string>

