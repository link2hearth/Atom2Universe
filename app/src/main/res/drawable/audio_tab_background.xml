<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/audio_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="?attr/a2uMusicAccentDim" />
                    <stroke android:width="1dp" android:color="?attr/a2uMusicAccent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>