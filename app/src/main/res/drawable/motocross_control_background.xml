        <shape><solid android:color="#365D65" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#65E1C2" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#365D65" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#65E1C2" /></shape>
    </item>
    <item>
        <shape><solid android:color="#223344" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#3A5063" /></shape>
    </item>
</selector>
