<?xml version="1.0" encoding="utf-8"?>
<!-- Sudoku couché : la bande du titre en haut, la grille sur toute la hauteur, et la bulle
     (chrono, difficulté, pavé 3 × 3, actions) qu'on glisse à gauche ou à droite. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary"
            android:contentDescription="@string/games_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/sudoku_title"
            android:textColor="@color/startup_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/sudoku_info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            android:tint="?attr/a2uMusicAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp">

            <com.Atom2Universe.app.games.sudoku.SudokuGridView
                android:id="@+id/sudoku_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/side_panel"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timer_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="8dp"
                    android:textColor="@color/startup_text_secondary"
                    android:textSize="30sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:gravity="center"
                    android:textColor="@color/startup_text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="2dp"
                    android:paddingBottom="10dp">

                    <com.Atom2Universe.app.util.ImmersiveSpinner
                        android:id="@+id/difficulty_spinner"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?attr/a2uChipBackground"
                        android:padding="8dp"
                        android:popupBackground="?attr/a2uPopupBackground" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_game_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sudoku_new_game"
                        android:textColor="@color/audio_on_accent"
                        app:backgroundTint="?attr/a2uMusicAccent" />
                </LinearLayout>

                <LinearLayout style="@style/SudokuLandPadRow">
                    <Button android:id="@+id/pad_1" style="@style/SudokuLandPadButton" android:text="1" android:textColor="@color/sudoku_number_1" />
                    <Button android:id="@+id/pad_2" style="@style/SudokuLandPadButton" android:text="2" android:textColor="@color/sudoku_number_2" />
                    <Button android:id="@+id/pad_3" style="@style/SudokuLandPadButton" android:text="3" android:textColor="@color/sudoku_number_3" />
                </LinearLayout>

                <LinearLayout style="@style/SudokuLandPadRow">
                    <Button android:id="@+id/pad_4" style="@style/SudokuLandPadButton" android:text="4" android:textColor="@color/sudoku_number_4" />
                    <Button android:id="@+id/pad_5" style="@style/SudokuLandPadButton" android:text="5" android:textColor="@color/sudoku_number_5" />
                    <Button android:id="@+id/pad_6" style="@style/SudokuLandPadButton" android:text="6" android:textColor="@color/sudoku_number_6" />
                </LinearLayout>

                <LinearLayout style="@style/SudokuLandPadRow">
                    <Button android:id="@+id/pad_7" style="@style/SudokuLandPadButton" android:text="7" android:textColor="@color/sudoku_number_7" />
                    <Button android:id="@+id/pad_8" style="@style/SudokuLandPadButton" android:text="8" android:textColor="@color/sudoku_number_8" />
                    <Button android:id="@+id/pad_9" style="@style/SudokuLandPadButton" android:text="9" android:textColor="@color/sudoku_number_9" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SudokuLandPadRow"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_undo"
                        style="@style/SudokuLandActionButton"
                        android:text="@string/sudoku_undo"
                        android:alpha="0.35"
                        android:enabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_notes"
                        style="@style/SudokuLandActionButton"
                        android:text="@string/sudoku_notes" />
                </LinearLayout>

                <LinearLayout style="@style/SudokuLandPadRow">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_clear"
                        style="@style/SudokuLandActionButton"
                        android:text="@string/sudoku_clear" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_validate"
                        style="@style/SudokuLandActionButton"
                        android:text="@string/sudoku_validate" />
                </LinearLayout>

                <LinearLayout style="@style/SudokuLandPadRow">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hint_button"
                        style="@style/SudokuLandActionButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/check_button"
                        style="@style/SudokuLandActionButton"
                        android:text="@string/sudoku_check" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
