<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audio_background">

    <!-- Barre du haut : retour, titre, annuler / rétablir, enregistrer, menu -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/audio_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_back"
            android:src="@drawable/ic_px_back" />

        <LinearLayout
            android:id="@+id/title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/txt_title"
                style="@style/PxTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txt_subtitle"
                style="@style/PxCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_undo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_undo"
            android:src="@drawable/ic_px_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_redo"
            android:src="@drawable/ic_px_redo" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageButton
                android:id="@+id/btn_save"
                style="@style/PxIconButton"
                android:contentDescription="@string/px_save"
                android:src="@drawable/ic_px_save" />

            <View
                android:id="@+id/save_dot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/px_dot"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/PxIconButton"
            android:contentDescription="@string/px_more"
            android:src="@drawable/ic_px_more" />
    </LinearLayout>

    <!-- Zone de dessin -->
    <com.Atom2Universe.app.pixelart.ui.PixelEditorView
        android:id="@+id/editor_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_stack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tools_scroll_v"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- Établi vertical : les boutons d'outils sont ajoutés par le code -->
    <ScrollView
        android:id="@+id/tools_scroll_v"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:background="@color/audio_surface"
        android:elevation="6dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_stack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:id="@+id/tools_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <!-- Réglages de l'outil en cours, flottant sur le haut de la zone -->
    <HorizontalScrollView
        android:id="@+id/options_scroll"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_px_panel"
        android:elevation="6dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/tools_scroll_v"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:id="@+id/options_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txt_zoom"
        style="@style/PxCaption"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_px_chip"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/audio_text_primary"
        app:layout_constraintBottom_toTopOf="@id/bottom_stack"
        app:layout_constraintStart_toEndOf="@id/tools_scroll_v" />

    <!-- Panneau des calques -->
    <LinearLayout
        android:id="@+id/layers_panel"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_px_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_stack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="420dp"
        app:layout_constraintTop_toBottomOf="@id/options_scroll"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/PxTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/px_layers"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_layer_add"
                style="@style/PxIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/px_layer_add"
                android:padding="8dp"
                android:src="@drawable/ic_px_add" />

            <ImageButton
                android:id="@+id/btn_layer_duplicate"
                style="@style/PxIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/px_layer_duplicate"
                android:padding="8dp"
                android:src="@drawable/ic_px_copy" />

            <ImageButton
                android:id="@+id/btn_layer_merge"
                style="@style/PxIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/px_layer_merge"
                android:padding="8dp"
                android:src="@drawable/ic_px_merge_down" />

            <ImageButton
                android:id="@+id/btn_layer_delete"
                style="@style/PxIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/px_layer_delete"
                android:padding="8dp"
                android:src="@drawable/ic_px_delete" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/layers_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Réglage de couleur : carte flottante au-dessus de la barre du bas, repliée par défaut -->
    <com.Atom2Universe.app.pixelart.ui.ColorDock
        android:id="@+id/color_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_stack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="340dp" />

    <!-- Pied : images, outils, couleurs -->
    <LinearLayout
        android:id="@+id/bottom_stack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/audio_surface"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/timeline_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <ImageButton
                        android:id="@+id/btn_play"
                        style="@style/PxIconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/px_play"
                        android:padding="8dp"
                        android:src="@drawable/ic_px_play" />

                    <ImageButton
                        android:id="@+id/btn_onion"
                        style="@style/PxIconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/px_onion"
                        android:padding="8dp"
                        android:src="@drawable/ic_px_onion" />

                    <ImageButton
                        android:id="@+id/btn_frame_add"
                        style="@style/PxIconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/px_frame_add"
                        android:padding="8dp"
                        android:src="@drawable/ic_px_add" />

                    <ImageButton
                        android:id="@+id/btn_frame_duplicate"
                        style="@style/PxIconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/px_frame_duplicate"
                        android:padding="8dp"
                        android:src="@drawable/ic_px_copy" />

                    <ImageButton
                        android:id="@+id/btn_frame_delete"
                        style="@style/PxIconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/px_frame_delete"
                        android:padding="8dp"
                        android:src="@drawable/ic_px_delete" />

                    <TextView
                        android:id="@+id/btn_frame_duration"
                        style="@style/PxCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_px_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/audio_text_primary" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/frames_list"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/px_divider" />

        <!-- Couleurs -->
        <LinearLayout
            android:id="@+id/color_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="42dp">

                <com.Atom2Universe.app.pixelart.ui.SwatchView
                    android:id="@+id/swatch_secondary"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/px_color_secondary" />

                <com.Atom2Universe.app.pixelart.ui.SwatchView
                    android:id="@+id/swatch_primary"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:contentDescription="@string/px_color_primary" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_swap"
                style="@style/PxIconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/px_color_swap"
                android:padding="7dp"
                android:src="@drawable/ic_px_flip_h" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/palette_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <ImageButton
                android:id="@+id/btn_palette"
                style="@style/PxIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/px_palette"
                android:padding="9dp"
                android:src="@drawable/ic_px_palette" />

            <ImageButton
                android:id="@+id/btn_layers"
                style="@style/PxIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/px_layers"
                android:padding="9dp"
                android:src="@drawable/ic_px_layers" />

            <ImageButton
                android:id="@+id/btn_timeline"
                style="@style/PxIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/px_frames"
                android:padding="9dp"
                android:src="@drawable/ic_px_film" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
