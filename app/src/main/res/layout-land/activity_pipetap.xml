<?xml version="1.0" encoding="utf-8"?>
<!-- PipeTap couché : la bande du titre en haut, la grille sur toute la hauteur restante, et la bulle
     (tailles de grille, état de la station) qu'on déplace à volonté. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">

    <LinearLayout
        android:id="@+id/pipetap_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/a2uSurfaceColor"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/pipetap_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/color_stack_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/a2uSecondaryTextColor" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/pipetap_title"
            android:textColor="?attr/a2uTextColor"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pipetap_moves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="?attr/a2uSecondaryTextColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pipetap_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="?attr/a2uSecondaryTextColor"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/pipetap_info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            android:tint="?attr/a2uMusicAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.Atom2Universe.app.games.pipetap.PipeTapView
                android:id="@+id/pipetap_game_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/pipetap_win_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/a2uBackgroundColor"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="16dp"
                    android:background="?attr/a2uPanelBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pipetap_solved"
                        android:textColor="?attr/a2uMusicAccent"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pipetap_win_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="?attr/a2uTextColor"
                        android:textSize="14sp" />

                    <com.Atom2Universe.app.util.FitRow
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pipetap_btn_again"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:text="@string/pipetap_btn_again"
                                android:textColor="?attr/a2uSecondaryTextColor" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pipetap_btn_next"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pipetap_btn_next"
                                android:textColor="?attr/a2uOnAccentColor"
                                android:backgroundTint="?attr/a2uMusicAccent" />
                        </LinearLayout>

                    </com.Atom2Universe.app.util.FitRow>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/side_panel"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/pipetap_diff_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/pipetap_diff_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/pipetap_status_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pipetap_station"
                        android:textColor="#C99C59"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pipetap_flow_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/a2uTextColor"
                        android:textSize="17sp" />

                    <ProgressBar
                        android:id="@+id/pipetap_flow_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:progressTint="?attr/a2uMusicAccent"
                        android:progressBackgroundTint="#35515A" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
