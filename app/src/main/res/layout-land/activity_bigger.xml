<?xml version="1.0" encoding="utf-8"?>
<!-- Accrétion couchée : le jeu prend tout l'écran ; la bannière (retour, score à gauche ;
     recommencer, règles à droite) est posée dessus, transparente, et l'astre tenu se promène entre
     ses deux moitiés. Le bocal monte ainsi juste en dessous. L'astre suivant est dessiné en grand
     par le jeu, à gauche du bocal. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/a2uScreenBackground">

    <com.Atom2Universe.app.games.bigger.BiggerView
        android:id="@+id/bigger_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="start|top"
        android:paddingStart="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/bigger_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bigger_tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="?attr/a2uTextColor"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/bigger_tv_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/a2uSecondaryTextColor"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="end|top"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/bigger_iv_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_bigger_next"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/bigger_btn_restart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/bigger_restart" />

        <ImageButton
            android:id="@+id/bigger_btn_info"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_info"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:tint="?attr/a2uMusicAccent" />
    </LinearLayout>
</FrameLayout>
