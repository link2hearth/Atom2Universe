<?xml version="1.0" encoding="utf-8"?>
<!-- Démineur couché : la bande du titre en haut, la grille (tournée d'un quart) sur toute la place
     restante, et la bulle (difficulté, chrono, mines, exploration, état) qu'on déplace à volonté. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/a2uScreenBackground"
    android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_24" android:tint="?attr/a2uSecondaryTextColor"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back_button_desc" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/minesweeper_abyss" android:textSize="24sp" android:textStyle="bold"
                android:letterSpacing="0.18" android:textColor="?attr/a2uTextColor" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/minesweeper_operation" android:textSize="10sp" android:letterSpacing="0.1" android:textColor="?attr/a2uMusicAccent" />
        </LinearLayout>
        <ImageButton android:id="@+id/btn_new_game" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_refresh" android:tint="?attr/a2uMusicAccent"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/minesweeper_new_game" />
        <ImageButton android:id="@+id/minesweeper_info_button" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:src="@drawable/ic_info"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/kit_rules"
            android:tint="?attr/a2uMusicAccent" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:orientation="horizontal">

        <FrameLayout android:id="@+id/grid_container" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="?attr/a2uPanelBackground" android:padding="6dp" />

        <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/side_panel" android:layout_width="260dp" android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.Atom2Universe.app.util.ImmersiveSpinner android:id="@+id/spinner_difficulty"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:backgroundTint="?attr/a2uMusicAccent" android:popupBackground="?attr/a2uPopupBackground" />

                <TextView android:id="@+id/tv_timer" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:paddingVertical="6dp"
                    android:textSize="34sp" android:textColor="?attr/a2uTextColor" android:fontFamily="monospace" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingHorizontal="8dp" android:paddingBottom="6dp">
                    <TextView android:id="@+id/tv_mines" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="#F5BF69" android:textSize="14sp" />
                    <TextView android:id="@+id/tv_explored" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="?attr/a2uMusicAccent" android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar android:id="@+id/exploration_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginHorizontal="8dp"
                    android:max="100" android:progressTint="#65E3CD" android:progressBackgroundTint="#183848" />

                <TextView android:id="@+id/tv_sonar_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:paddingTop="10dp"
                    android:textSize="14sp" android:textColor="?attr/a2uMusicAccent" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
