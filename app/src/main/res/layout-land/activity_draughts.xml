<?xml version="1.0" encoding="utf-8"?>
<!-- Dames couchées : la bande du titre en haut, le damier sur toute la hauteur, et la bulle
     (pendule, tour de jeu, niveau et nouvelle partie) qu'on déplace à volonté. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/a2uPanelBackground">

        <ImageButton
            android:id="@+id/draughts_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_app_back"
            android:tint="@color/audio_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/draughts_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/draughts_info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_info"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kit_rules"
            android:tint="?attr/a2uMusicAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp">

            <com.Atom2Universe.app.games.draughts.DraughtsView
                android:id="@+id/draughts_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/side_panel"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/draughts_timer_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/draughts_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <com.Atom2Universe.app.util.ImmersiveSpinner
                    android:id="@+id/draughts_difficulty_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/draughts_new_game_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/draughts_new_game" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
