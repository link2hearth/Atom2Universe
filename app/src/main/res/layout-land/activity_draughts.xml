<?xml version="1.0" encoding="utf-8"?>
<!-- Dames couché : la même bannière qu'en portrait (chrono, difficulté, nouvelle partie en icône),
     le damier carré sur toute la hauteur au milieu de l'écran, et à sa gauche à qui de jouer.
     Plus de bulle : rien à déplacer, rien de rogné. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/a2uScreenBackground">
    <tag android:id="@id/app_effects_scene" android:value="true" />

    <com.Atom2Universe.app.util.FitRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/draughts_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="?attr/a2uPanelBackground">

            <ImageButton
                android:id="@+id/draughts_back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_app_back"
                android:tint="@color/audio_text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/draughts_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/draughts_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="00:00"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary" />

            <com.Atom2Universe.app.util.ImmersiveSpinner
                android:id="@+id/draughts_difficulty_spinner"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/a2uChipBackground"
                android:paddingHorizontal="6dp"
                android:popupBackground="?attr/a2uPopupBackground"
                android:spinnerMode="dropdown" />

            <ImageButton
                android:id="@+id/draughts_new_game_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/draughts_new_game"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="@color/audio_text_primary" />

            <ImageButton
                android:id="@+id/draughts_info_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_info"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kit_rules"
                android:tint="?attr/a2uMusicAccent" />
        </LinearLayout>
    </com.Atom2Universe.app.util.FitRow>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <!-- Le damier au milieu de l'écran -->
        <com.Atom2Universe.app.games.draughts.DraughtsView
            android:id="@+id/draughts_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- À sa gauche : à qui de jouer -->
        <TextView
            android:id="@+id/draughts_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/draughts_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
